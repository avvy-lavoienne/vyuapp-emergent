# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=your_database_name

# Site URL (used by sitemap, OG images, canonical)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials (used by /api/admin/setup and E2E tests)
SUPABASE_ADMIN_EMAIL=admin@vyuapp.my.id
SUPABASE_ADMIN_DEFAULT_PASSWORD=YourSecurePassword

# Test environment (copy to .env.test for E2E tests)
# See .env.test.example for test-specific configuration

# Google AdSense (optional — omit if not using)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=xxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_MID=xxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_END=xxxxxxxxx

# Cloudflare Turnstile (discovery form anti-spam)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# Resend (contact form email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# CORS (defaults to * if not set)
CORS_ORIGINS=*

# One-time admin setup token (required for /api/admin/setup)
SETUP_TOKEN=your-secret-setup-token-here
