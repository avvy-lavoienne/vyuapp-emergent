# Test environment — E2E tests
# Copy this to .env.test and fill in your Supabase credentials.
# global-setup.ts loads .env.test automatically.

# Supabase (required for auth tests)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin test credentials (used by global-setup.ts and tests)
SUPABASE_ADMIN_EMAIL=admin@vyuapp.my.id
SUPABASE_ADMIN_DEFAULT_PASSWORD=your-admin-password
SETUP_TOKEN=your-setup-token
